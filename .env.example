# Copy to .env and fill in what you have. Blank values are ignored.
# Loaded automatically by `newsscore` and NewsScorer.from_config() from the working
# directory; real environment variables always take precedence.

# --- scorer -----------------------------------------------------------------
# TypeSafe AI (Jev). Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=

# --- news sources ---------------------------------------------------------
FINNHUB_API_KEY=            # https://finnhub.io
ALPHAVANTAGE_API_KEY=       # https://www.alphavantage.co
POLYGON_API_KEY=            # https://massive.com (formerly polygon.io; MASSIVE_API_KEY also works)
TIINGO_API_KEY=             # https://www.tiingo.com
MARKETAUX_API_KEY=          # https://www.marketaux.com
NEWSAPI_API_KEY=            # https://newsapi.org

# --- optional paths -------------------------------------------------------
# NEWSSCORE_CONFIG=E:\test_data\jev_sentiment\live\sources.json   # saved sources file
# NEWSSCORE_CACHE=E:\test_data\jev_sentiment\live\scores.sqlite   # score cache
# NEWSSCORE_ENV=                                                   # explicit .env location
